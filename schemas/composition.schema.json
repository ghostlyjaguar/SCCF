{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCCF composition draft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "temporal_constraint": {
      "type": "string",
      "minLength": 1
    },
    "defensive_significance": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^SCCF-[0-9]{4,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "proposed",
        "reviewed",
        "accepted",
        "deprecated"
      ]
    },
    "relationship": {
      "enum": [
        "diverts",
        "conceals",
        "enables",
        "suppresses",
        "amplifies",
        "deceives"
      ]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "relevance"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "exclusion_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "attack_mappings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T\\d{4}(\\.\\d{3})?$"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "name",
    "definition",
    "temporal_constraint",
    "defensive_significance",
    "id",
    "version",
    "status",
    "relationship",
    "references",
    "aliases",
    "roles",
    "evidence_requirements",
    "exclusion_criteria",
    "attack_mappings"
  ]
}
